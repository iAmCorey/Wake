---
// The handful of glyphs the site needs, inline so nothing extra loads.
interface Props {
  name: 'github' | 'apple' | 'linux' | 'windows' | 'star' | 'search' | 'download' | 'terminal' | 'chevron' | 'globe' | 'check';
  class?: string;
}
const { name, class: className } = Astro.props;
---

{
  name === 'github' && (
    <svg class={className} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
    </svg>
  )
}
{
  name === 'apple' && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.37 12.65c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.83-.81-3-.79-1.55.02-2.97.9-3.77 2.29-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.51 1.25-2.58-.03-.01-2.4-.92-2.42-3.66zM14.1 5.89c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.68-1.09 1.76-.95 2.8 1.01.08 2.04-.51 2.67-1.28z" />
    </svg>
  )
}
{
  name === 'linux' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3c-2 0-3.2 1.7-3.2 4.2 0 1.6.5 2.6-.5 4.3C7 13.5 5.8 15 5.8 17.2c0 1 .5 1.8 1.3 2.3M12 3c2 0 3.2 1.7 3.2 4.2 0 1.6-.5 2.6.5 4.3 1.3 2 2.5 3.5 2.5 5.7 0 1-.5 1.8-1.3 2.3" />
      <path d="M9 21c-1.4 0-2.6-.6-2.6-1.6 0-.8 1-1.4 2.1-1.4 1 0 1.7.7 1.7 1.6 0 .8-.5 1.4-1.2 1.4zM15 21c1.4 0 2.6-.6 2.6-1.6 0-.8-1-1.4-2.1-1.4-1 0-1.7.7-1.7 1.6 0 .8.5 1.4 1.2 1.4zM10.6 8.5h.01M13.4 8.5h.01M10.8 10.8c.8.6 1.6.6 2.4 0" />
    </svg>
  )
}
{
  name === 'windows' && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3 5.5l7.5-1v7H3v-6zm0 13l7.5 1v-7H3v6zm8.5 1.1L21 21v-8.5h-9.5v7.1zm0-15.2v7.1H21V3l-9.5 1.4z" />
    </svg>
  )
}
{
  name === 'star' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
    </svg>
  )
}
{
  name === 'search' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="M20 20l-3.5-3.5" />
