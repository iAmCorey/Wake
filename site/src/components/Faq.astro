---
import { COPY, type Lang } from '../lib/copy';

interface Props {
  lang: Lang;
}
const t = COPY[Astro.props.lang].faq;
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.title}</h2>
    </div>
    <div class="faq">
      {
        t.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

